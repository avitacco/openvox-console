/frontend/node_modules/
# marketing/ has its own package.json for development-only tooling
# (axe-core, for the accessibility audit). The site itself takes
# voxblocks from frontend/'s lockfile, so the two cannot drift.
/marketing/node_modules/
/bin/
/.env
/certs/
/.dev/
/internal/agentdist/bin/
/internal/agentdist/packages/

# docs/ is deliberately NOT ignored. It is the built marketing site, and
# GitHub Pages serves it straight from this branch - so it is committed
# on purpose. Rebuild it with `make marketing`, look at it, then push.

# Production secrets for docker-compose.yml (CONSOLE_SECRETS_DIR).
# dev-secrets/ is deliberately NOT ignored - it holds throwaway values
# for the local stack, see dev-secrets/README.md.
/secrets/

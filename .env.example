# Example environment for a PRODUCTION deployment.
#
# Copy this next to docker-compose.yml on the deployment host, as .env,
# and edit. Compose reads it for ${...} substitution:
#
#   cp .env.example /opt/openvox-console/.env
#   cd /opt/openvox-console && docker compose -f docker-compose.yml up -d
#
# This file holds no secrets. Passwords, the database DSN and the
# enc-bridge token are Docker secrets, read from files under
# CONSOLE_SECRETS_DIR - see SETUP.md step 6.
#
# For local development you want a different, much larger .env in the
# repo root, read by the console binary itself rather than by Compose -
# see README.md and internal/runtime/config.go.

# ---------------------------------------------------------------------
# Required. Compose refuses to start without these, naming the one that
# is missing, so a deployment cannot silently come up on a placeholder.
# ---------------------------------------------------------------------

# This console's externally-reachable base URL. Written into the agent
# install script and into the "sign this node's certificate" message, so
# it must be the address an operator and a node can actually reach.
CONSOLE_BASE_URL=https://console.example.com

# What a *remote node* dials for the NATS node transport. The host part
# must be a name present in the node-transport certificate's SANs
# (SETUP.md step 4c) or nodes fail TLS verification.
CONSOLE_NODE_TRANSPORT_PUBLIC_ADDR=console.example.com:8142

# openvoxdb's database password. Not a Docker secret: openvoxdb can only
# take it from an environment variable, so a secret file would move just
# one half of the pair out of the environment - see the note in
# docker-compose.yml.
OPENVOXDB_POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------
# Image versions. Defaults shown; uncomment to pin.
# ---------------------------------------------------------------------

# The console image. :main follows the main branch. :latest and semver
# tags exist only once a v* tag has been pushed, so :latest is NOT a
# valid choice until the first release is cut. Pin an exact commit with
# the immutable sha- tag, or a release once you have one.
#CONSOLE_IMAGE_TAG=main
#CONSOLE_IMAGE_TAG=sha-a1b2c3d
#CONSOLE_IMAGE_TAG=v1.2.3

# Override only to run a fork or a mirror.
#CONSOLE_IMAGE=ghcr.io/avitacco/openvox-console

# openvoxserver. This is NOT the stock openvoxproject image: it adds the
# enc-bridge binary and the node_terminus=exec wiring that make the
# console this server's node classifier. Built by the same CI run as the
# console image, so keep the two tags in step. On the stock image the
# stack still starts and looks healthy, but node groups classify nothing.
#OPENVOXSERVER_IMAGE=ghcr.io/avitacco/openvox-console-server
#OPENVOXSERVER_IMAGE_TAG=main

# openvoxdb image.
#OPENVOX_VERSION=latest

# Postgres images, pinned separately since the two databases are
# independent. Both volumes are mounted at /var/lib/postgresql, which is
# what 18+ expects - going *back* to 17 or earlier needs the mount moved
# to /var/lib/postgresql/data as well, not just the version changed.
#CONSOLE_POSTGRES_VERSION=18-alpine
#OPENVOXDB_POSTGRES_VERSION=18-alpine

# ---------------------------------------------------------------------
# Where credentials live on the host.
# ---------------------------------------------------------------------

# Step 4's certificates, mounted read-only into the console.
#CONSOLE_CERTS_DIR=./certs

# Docker secret files, one value per file: console_postgres_dsn,
# console_postgres_password, console_bootstrap_admin_password,
# enc_bridge_token.
#
# Compose bind-mounts these with their host ownership, and the two
# containers run as different users - the console as root, openvoxserver
# as puppet:0. So enc_bridge_token needs `chgrp 0` + mode 0640 to be
# readable at all, while the rest can stay 0600. Protect the directory
# (mode 0700) rather than the individual files. SETUP.md step 7.
#CONSOLE_SECRETS_DIR=./secrets

# ---------------------------------------------------------------------
# Published ports. Change where something else already owns one - note
# openvoxdb itself listens on 8080 for plain HTTP, so co-locating it
# with the console means moving one of them.
# ---------------------------------------------------------------------

#CONSOLE_HTTP_PORT=8080
#CONSOLE_NODE_TRANSPORT_PORT=8142
#OPENVOXSERVER_PORT=8140

# ---------------------------------------------------------------------
# Certificate names. Every name anything uses to reach a service has to
# be in that service's certificate, or TLS verification fails. A
# certificate is always valid for its own certname, so these are only
# for *additional* names.
# ---------------------------------------------------------------------

#OPENVOXSERVER_HOSTNAME=openvoxserver
#OPENVOXSERVER_DNS_ALT_NAMES=puppet.example.com
#OPENVOXDB_DNS_ALT_NAMES=

# ---------------------------------------------------------------------
# Optional behaviour.
# ---------------------------------------------------------------------

# Accepts true|false|<path to an allowlist file>. The default is an
# allowlist containing only "openvoxdb", which has to enrol unattended
# (it is a service in this stack, with no operator waiting on it, and it
# wedges itself permanently if its request is not signed within 120s).
# Real nodes are NOT covered and still need signing from the Nodes page.
# Setting this to true lets anything that can reach port 8140 enrol.
#OPENVOXSERVER_AUTOSIGN=/etc/puppetlabs/puppet/autosign.conf

# The Puppet server a *node* enrols against - node-facing, so not the
# console's own view of the CA. Must match a name in openvoxserver's
# certificate. Unset leaves a node's existing configuration alone.
#CONSOLE_PUPPET_SERVER_PUBLIC_ADDR=puppet.example.com

# Creates the first admin user, and only while the users table is empty.
# Its password comes from the console_bootstrap_admin_password secret.
# Remove both once you have logged in and changed the password.
#CONSOLE_BOOTSTRAP_ADMIN_USERNAME=admin

# Where enc-bridge, running inside the openvoxserver container, reaches
# the console. The compose network name works as-is; change it only if
# the console runs outside this stack.
#ENC_BRIDGE_URL=http://console:8080

# ---------------------------------------------------------------------
# OIDC login. Entirely optional - inactive while the issuer is unset, and
# it never replaces local login or service tokens. The redirect path is
# fixed by the console and must be registered with the provider exactly.
#
# Your provider must put the username and role claims in the ID TOKEN,
# not only at its userinfo endpoint - some withhold non-essential claims
# from the ID token by default and need a setting to include them.
# ---------------------------------------------------------------------

#CONSOLE_OIDC_ISSUER=https://id.example.com
#CONSOLE_OIDC_CLIENT_ID=
#CONSOLE_OIDC_CLIENT_SECRET=
#CONSOLE_OIDC_REDIRECT_URL=https://console.example.com/api/v1/auth/oidc/callback

# Defaults shown. ROLE_MAPPING is a JSON object mapping a value of the
# role claim to a console role that ALREADY EXISTS - unmapped values are
# ignored, and roles an administrator assigned by hand are never touched.
#CONSOLE_OIDC_SCOPES=openid profile email groups
#CONSOLE_OIDC_USERNAME_CLAIM=email
#CONSOLE_OIDC_ROLE_CLAIM=groups
#CONSOLE_OIDC_ROLE_MAPPING={"console-admins":"admin"}

# The console's own database name and role, if you are not using the
# defaults. These must match what the console_postgres_dsn secret says.
#CONSOLE_POSTGRES_USER=console
#CONSOLE_POSTGRES_DB=console
#OPENVOXDB_POSTGRES_USER=openvoxdb
#OPENVOXDB_POSTGRES_DB=openvoxdb

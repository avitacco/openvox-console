msgid "Nodes and inventory"
msgstr "Nodes et inventaire"

#: ../marketing/gen/main.go:62
msgid "Nodes and inventory - OpenVox Console"
msgstr "Nodes et inventaire - OpenVox Console"

#: ../marketing/templates/pages/index.tmpl:63
msgid "One binary to run"
msgstr "Un seul binaire à faire tourner"

#: ../marketing/templates/pages/features/code.tmpl:10
msgid "One control repository, or one per team"
msgstr "Un dépôt de contrôle, ou un par équipe"

#: ../marketing/templates/pages/features/nodes.tmpl:44
msgid "One node in full"
msgstr "Un Node en entier"


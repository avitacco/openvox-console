msgstr "الـ Nodes والجرد"

#: ../marketing/gen/main.go:70
msgid "Nodes and inventory - OpenVox Console"
msgstr "الـ Nodes والجرد - OpenVox Console"

#: ../marketing/templates/pages/index.tmpl:63
#~ msgid "One binary to run"
#~ msgstr "ملف تنفيذي واحد لتشغيله"

#: ../marketing/templates/pages/features/code.tmpl:33

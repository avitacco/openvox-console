msgstr "{user}(으)로 실행"

#: src/agentless.js:173
msgid "{name} failed at {stage}: {reason}"
msgstr "{name}이(가) {stage}에서 실패했습니다: {reason}"

#: src/agentless.js:191
msgid "{name} is presenting a different host key from the one pinned. Nothing was sent to it. Replace the pin only if you know the host was rebuilt or its key rotated."
msgstr "{name}이(가) 고정된 키와 다른 호스트 키를 제시합니다. 아무것도 전송하지 않았습니다. 호스트가 재구축되었거나 키가 교체된 것을 아는 경우에만 고정을 교체하세요."

#: src/agentless.js:171
msgid "{name} is reachable. Logged in as {user}{as}."
msgstr "{name}에 접속할 수 있습니다. {user}{as}(으)로 로그인했습니다."

#: src/agentless.js:193
msgid "{name} presented this host key. Compare it with the host's own (ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub) before trusting it."
msgstr "{name}이(가) 이 호스트 키를 제시했습니다. 신뢰하기 전에 호스트 자체의 키(ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub)와 비교하세요."

#: src/agentless.js:226
msgid "{name} will be deleted. A credential still used by a target cannot be deleted."
msgstr "{name}을(를) 삭제합니다. 대상이 아직 사용 중인 자격 증명은 삭제할 수 없습니다."

#: src/agentless.js:211
msgid "{name} will no longer be reachable from the console. Its stored login is deleted."
msgstr "{name}에 콘솔에서 더 이상 접속할 수 없게 됩니다. 저장된 로그인 정보는 삭제됩니다."


{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-subnav label="Admin" class="vox-m-bottom-lg">
        <a href="/users.html">Users</a>
        <a href="/roles.html" aria-current="page">Roles</a>
        <a href="/service-tokens.html">Service tokens</a>
      </vox-subnav>

      <h1 class="vox-ts-xl vox-m-bottom-md">Roles</h1>

      <section>
        <h2>New role</h2>
        <div id="create-error"></div>
        <div class="vox-m-bottom-md">
          <vox-input id="new-role-name" label="Name" required></vox-input>
        </div>
        <div class="vox-m-bottom-md">
          <div id="new-role-permissions" class="vox-display-flex vox-flex-wrap vox-gap-md"></div>
        </div>
        <div class="vox-display-flex vox-gap-sm vox-m-top-lg">
          <vox-button id="create-role" variant="brand">Create role</vox-button>
        </div>
      </section>

      <section>
        <h2>All roles</h2>
        <div id="results"></div>
      </section>
    </main>
{{- end}}

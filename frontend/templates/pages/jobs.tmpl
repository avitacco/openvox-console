{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <div class="vox-display-flex vox-justify-between vox-items-center vox-gap-md vox-flex-wrap vox-m-bottom-md">
        <h1 class="vox-ts-xl vox-m-y-none" data-i18n>Jobs</h1>
        <div id="start-actions" style="display: none">
          <div class="vox-display-flex vox-gap-sm">
            <vox-button id="run-task" variant="alt" data-i18n>Run task</vox-button>
            <vox-button id="run-puppet" variant="brand" data-i18n>Run Puppet</vox-button>
          </div>
        </div>
      </div>
      <vox-subnav label="Jobs" class="vox-m-bottom-lg" data-i18n-attr="label">
        <a href="/jobs.html" aria-current="page" data-i18n>Job history</a>
        <a href="/schedules.html" data-i18n>Scheduled jobs</a>
        <a href="/plans.html" data-i18n>Plans</a>
        <a href="/approvals.html" id="approvals-tab" style="display: none" data-i18n>Approvals</a>
      </vox-subnav>

      <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
        <vox-input id="target-filter" label="Target" placeholder="Filter by node" data-i18n-attr="label,placeholder"></vox-input>
        <vox-select id="kind-filter" label="Kind" data-i18n-attr="label">
          <option value="" data-i18n>All</option>
          <option value="run" data-i18n>Run</option>
          <option value="task" data-i18n>Task</option>
          <option value="plan" data-i18n>Plan</option>
          <option value="patch" data-i18n>Patch run</option>
          <option value="codeplan" data-i18n>Code plan</option>
        </vox-select>
        <vox-select id="status-filter" label="Status" data-i18n-attr="label">
          <option value="" data-i18n>All</option>
          <option value="running" data-i18n>Running</option>
          <option value="succeeded" data-i18n>Succeeded</option>
          <option value="failed" data-i18n>Failed</option>
        </vox-select>
        <vox-input id="triggered-by-filter" label="Triggered by" placeholder="Filter by actor" data-i18n-attr="label,placeholder"></vox-input>
        <vox-select id="agent-filter" label="Started by" data-i18n-attr="label">
          <option value="" data-i18n>Anyone</option>
          <option value="true" data-i18n>AI agents (approved)</option>
        </vox-select>
        <vox-select id="sort-order" label="Order" data-i18n-attr="label">
          <option value="desc" data-i18n>Newest first</option>
          <option value="asc" data-i18n>Oldest first</option>
        </vox-select>
      </div>

      <div id="results"></div>
    </main>
{{- end}}

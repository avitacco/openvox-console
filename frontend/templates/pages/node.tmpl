{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-breadcrumbs>
        <a href="/">Nodes</a>
        <span id="node-name" aria-current="page">…</span>
      </vox-breadcrumbs>
      <div class="vox-display-flex vox-justify-between vox-items-center vox-gap-md vox-m-bottom-md">
        <h1 id="node-heading" class="vox-ts-xl vox-m-y-none">…</h1>
        <vox-button id="run-now" variant="brand" style="display: none">Run now</vox-button>
      </div>

      <div id="run-now-error"></div>

      <vox-tabs>
        <vox-tab slot="tab" panel="facts" selected>Facts</vox-tab>
        <vox-tab slot="tab" panel="packages">Packages</vox-tab>
        <vox-tab slot="tab" panel="vulnerabilities" id="vulnerabilities-tab" style="display: none">Vulnerabilities</vox-tab>
        <vox-tab slot="tab" panel="runs">Runs</vox-tab>

        <vox-tab-panel name="facts">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <vox-switch id="facts-raw-switch">Raw JSON</vox-switch>
          </div>
          <div id="facts"></div>
        </vox-tab-panel>

        <vox-tab-panel name="packages">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <div id="package-inventory-toggle" style="display: none">
              <vox-switch id="package-inventory-switch">Report installed packages</vox-switch>
            </div>
          </div>
          <div id="package-inventory-status"></div>
          <div id="packages"></div>
        </vox-tab-panel>

        <vox-tab-panel name="vulnerabilities">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <vox-switch id="vulnerabilities-closed-switch">Show closed</vox-switch>
          </div>
          <div id="vulnerabilities-coverage"></div>
          <div id="vulnerabilities"></div>
        </vox-tab-panel>

        <vox-tab-panel name="runs">
          <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
            <vox-select id="status-filter" label="Status">
              <option value="">All</option>
              <option value="changed">Changed</option>
              <option value="unchanged">Unchanged</option>
              <option value="failed">Failed</option>
              <option value="noop">Noop</option>
            </vox-select>
          </div>
          <div id="reports"></div>
        </vox-tab-panel>
      </vox-tabs>
    </main>
{{- end}}

{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-breadcrumbs>
        <a href="/" data-i18n>Nodes</a>
        <span id="node-name" aria-current="page">…</span>
      </vox-breadcrumbs>
      <div class="vox-display-flex vox-justify-between vox-items-center vox-gap-md vox-m-bottom-md">
        <h1 id="node-heading" class="vox-ts-xl vox-m-y-none">…</h1>
        <vox-button id="run-now" variant="brand" style="display: none" data-i18n>Run now</vox-button>
      </div>

      <div id="run-now-error"></div>

      <vox-tabs>
        <vox-tab slot="tab" panel="facts" selected data-i18n>Facts</vox-tab>
        <vox-tab slot="tab" panel="packages" data-i18n>Packages</vox-tab>
        <vox-tab slot="tab" panel="vulnerabilities" id="vulnerabilities-tab" style="display: none" data-i18n>Vulnerabilities</vox-tab>
        <vox-tab slot="tab" panel="runs" data-i18n>Runs</vox-tab>

        <vox-tab-panel name="facts">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <vox-switch id="facts-raw-switch" data-i18n>Raw JSON</vox-switch>
          </div>
          <div id="facts"></div>
        </vox-tab-panel>

        <vox-tab-panel name="packages">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <div id="package-inventory-toggle" style="display: none">
              <vox-switch id="package-inventory-switch" data-i18n>Report installed packages</vox-switch>
            </div>
          </div>
          <div id="package-inventory-status"></div>
          <div id="packages"></div>
        </vox-tab-panel>

        <vox-tab-panel name="vulnerabilities">
          <div class="vox-display-flex vox-justify-end vox-items-center vox-gap-md vox-m-bottom-md">
            <vox-switch id="vulnerabilities-closed-switch" data-i18n>Show closed</vox-switch>
          </div>
          <div id="vulnerabilities-coverage"></div>
          <div id="vulnerabilities"></div>
        </vox-tab-panel>

        <vox-tab-panel name="runs">
          <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
            <vox-select id="status-filter" label="Status" data-i18n-attr="label">
              <option value="" data-i18n>All</option>
              <option value="changed" data-i18n>Changed</option>
              <option value="unchanged" data-i18n>Unchanged</option>
              <option value="failed" data-i18n>Failed</option>
              <option value="noop" data-i18n>Noop</option>
            </vox-select>
          </div>
          <div id="reports"></div>
        </vox-tab-panel>
      </vox-tabs>
    </main>
{{- end}}

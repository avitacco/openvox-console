{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <div class="vox-display-flex vox-justify-between vox-items-center vox-gap-md vox-m-bottom-md">
        <h1 class="vox-ts-xl vox-m-y-none" data-i18n>Vulnerabilities</h1>
        <a id="providers-link" href="/vulnerability-providers.html" style="display: none" data-i18n>Manage providers</a>
      </div>

      <div id="coverage" class="vox-m-bottom-lg"></div>

      <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
        <vox-select id="severity-filter" label="Severity" data-i18n-attr="label">
          <option value="" data-i18n>All</option>
          <option value="critical" data-i18n>Critical</option>
          <option value="high" data-i18n>High</option>
          <option value="medium" data-i18n>Medium</option>
          <option value="low" data-i18n>Low</option>
          <option value="unknown" data-i18n>Unknown</option>
        </vox-select>
        <vox-select id="fix-filter" label="Fix" data-i18n-attr="label">
          <option value="" data-i18n>All</option>
          <option value="true" data-i18n>Fix available</option>
          <option value="false" data-i18n>No fix released</option>
        </vox-select>
        <vox-select id="provider-filter" label="Provider" style="display: none" data-i18n-attr="label">
          <option value="" data-i18n>All</option>
        </vox-select>
        <vox-input id="package-filter" label="Package" placeholder="e.g. openssl" data-i18n-attr="label,placeholder"></vox-input>
        <vox-select id="sort-order" label="Sort" data-i18n-attr="label">
          <option value="severity" data-i18n>Most severe first</option>
          <option value="affected" data-i18n>Most affected nodes first</option>
        </vox-select>
      </div>

      <div id="results"></div>
    </main>
{{- end}}

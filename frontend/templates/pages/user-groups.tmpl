{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-subnav label="Admin" class="vox-m-bottom-lg" data-i18n-attr="label">
        <a href="/users.html" data-i18n>Users</a>
        <a href="/user-groups.html" aria-current="page" data-i18n>User groups</a>
        <a href="/roles.html" data-i18n>Roles</a>
        <a href="/service-tokens.html" data-i18n>Service tokens</a>
        <a href="/agent-tokens.html" data-i18n>Agent tokens</a>
        <a href="/account-policy.html" data-i18n>Account policy</a>
      </vox-subnav>

      <h1 class="vox-ts-xl vox-m-bottom-md" data-i18n>User groups</h1>
      <p class="vox-ts-sm vox-color-text-2 vox-m-top-none vox-m-bottom-lg" data-i18n>
        A group gives its members the roles granted to it, in addition to any roles they hold themselves.
        Each role keeps its own node groups and task limits.
      </p>

      <section>
        <h2 data-i18n>New group</h2>
        <div id="create-error"></div>
        <div class="vox-m-bottom-md">
          <vox-input id="new-group-name" label="Name" required data-i18n-attr="label"></vox-input>
        </div>
        <div class="vox-display-flex vox-gap-sm vox-m-top-lg">
          <vox-button id="create-group" variant="brand" data-i18n>Create group</vox-button>
        </div>
      </section>

      <section>
        <h2 data-i18n>All groups</h2>
        <div id="results"></div>
      </section>
    </main>
{{- end}}

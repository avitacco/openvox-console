{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-breadcrumbs>
        <a href="/jobs.html" data-i18n>Jobs</a>
        <a href="/plans.html" data-i18n>Plans</a>
        <span id="breadcrumb-current" aria-current="page" data-i18n>Plan</span>
      </vox-breadcrumbs>
      <div class="vox-display-flex vox-justify-between vox-items-center vox-gap-md vox-flex-wrap vox-m-bottom-md">
        <h1 id="heading" class="vox-ts-xl vox-m-y-none">…</h1>
        <div id="controls" style="display: none">
          <div class="vox-display-flex vox-gap-sm">
            <vox-button id="run" variant="brand" data-i18n>Run</vox-button>
            <vox-button id="edit" variant="alt" data-i18n>Edit</vox-button>
            <vox-button id="delete" variant="danger" data-i18n>Delete</vox-button>
          </div>
        </div>
      </div>
      <div id="action-error"></div>
      <div id="summary" class="vox-m-bottom-lg"></div>

      <section>
        <h2 data-i18n>Steps</h2>
        <div id="steps"></div>
      </section>
    </main>
{{- end}}

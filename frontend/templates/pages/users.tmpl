{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <vox-subnav label="Admin" class="vox-m-bottom-lg" data-i18n-attr="label">
        <a href="/users.html" aria-current="page" data-i18n>Users</a>
        <a href="/roles.html" data-i18n>Roles</a>
        <a href="/service-tokens.html" data-i18n>Service tokens</a>
      </vox-subnav>

      <h1 class="vox-ts-xl vox-m-bottom-md" data-i18n>Users</h1>

      <section>
        <h2 data-i18n>New user</h2>
        <div id="create-error"></div>
        <div class="vox-m-bottom-md">
          <vox-input id="new-username" label="Username" required data-i18n-attr="label"></vox-input>
        </div>
        <div class="vox-m-bottom-md">
          <vox-input id="new-password" label="Password" type="password" required data-i18n-attr="label"></vox-input>
        </div>
        <div class="vox-display-flex vox-gap-md vox-flex-wrap vox-m-bottom-md">
          <vox-input id="new-first-name" label="First name (optional)" data-i18n-attr="label"></vox-input>
          <vox-input id="new-last-name" label="Last name (optional)" data-i18n-attr="label"></vox-input>
          <vox-input id="new-email" label="Email (optional)" type="email" data-i18n-attr="label"></vox-input>
        </div>
        <div class="vox-display-flex vox-gap-sm vox-m-top-lg">
          <vox-button id="create-user" variant="brand" data-i18n>Create user</vox-button>
        </div>
      </section>

      <section>
        <h2 data-i18n>All users</h2>
        <div id="results"></div>
      </section>
    </main>
{{- end}}

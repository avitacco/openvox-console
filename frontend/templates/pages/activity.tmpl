{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <h1 class="vox-ts-xl vox-m-bottom-md">Activity</h1>

      <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
        <vox-combobox id="category-filter" label="Category" placeholder="All">
          <option value="">All</option>
        </vox-combobox>
        <vox-combobox id="action-filter" label="Action" placeholder="All">
          <option value="">All</option>
        </vox-combobox>
        <vox-input id="actor-filter" label="Actor" placeholder="Filter by actor"></vox-input>
        <vox-select id="sort-order" label="Order">
          <option value="desc">Newest first</option>
          <option value="asc">Oldest first</option>
        </vox-select>
      </div>

      <div id="results"></div>
    </main>
{{- end}}

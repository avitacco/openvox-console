{{define "content" -}}
    <main class="vox-container vox-p-y-xl">
      <h1 class="vox-ts-xl vox-m-bottom-md" data-i18n>Activity</h1>

      <div class="filters vox-display-flex vox-items-end vox-gap-md vox-flex-wrap vox-m-bottom-lg">
        <vox-combobox id="category-filter" label="Category" placeholder="All" data-i18n-attr="label,placeholder">
          <option value="" data-i18n>All</option>
        </vox-combobox>
        <vox-combobox id="action-filter" label="Action" placeholder="All" data-i18n-attr="label,placeholder">
          <option value="" data-i18n>All</option>
        </vox-combobox>
        <vox-input id="actor-filter" label="Actor" placeholder="Filter by actor" data-i18n-attr="label,placeholder"></vox-input>
        <vox-select id="sort-order" label="Order" data-i18n-attr="label">
          <option value="desc" data-i18n>Newest first</option>
          <option value="asc" data-i18n>Oldest first</option>
        </vox-select>
      </div>

      <div id="results"></div>
    </main>
{{- end}}
